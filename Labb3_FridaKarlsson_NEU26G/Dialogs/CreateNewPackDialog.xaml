<Window x:Class="Labb3_FridaKarlsson_NEU26G.Dialogs.CreateNewPackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb3_FridaKarlsson_NEU26G.Dialogs"
        xmlns:viewmodels="clr-namespace:Labb3_FridaKarlsson_NEU26G.ViewModels"
        mc:Ignorable="d"
        Title="Create New Pack" Height="250" Width="200" ResizeMode="NoResize" WindowStyle="ToolWindow"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel, IsDesignTimeCreatable=True}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Grid.Row="0"
            Grid.RowSpan="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="170"
            Margin="10"
        >

            <Label 
                Content="Pack Name:"
                FontWeight="Bold"
                Padding="4 5 4 2"
            />

            <TextBox 
                x:Name="textBoxNewPackName"
                Text="{Binding Name}"
                Margin="3 2 3 2"
            />

            <Label 
                Content="Difficulty"
                FontWeight="Bold"
                Padding="4 5 4 2"
            />

            <ComboBox 
                
                SelectedItem="{Binding Difficulty}"
                Margin="3 2 3 2"
            >

            </ComboBox>


            <DockPanel>
                <Label 
                   DockPanel.Dock="Left"
                   FontWeight="Bold"
                   Padding="4 5 4 2"
                >                    
                    <TextBlock>          
                        <Run Text="Time Limit:"/>
                    </TextBlock>                    
                </Label>

                <Label 
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Padding="4 5 4 2"
                >
                    <TextBlock>                    
                    <Run Text="{Binding ElementName=TimeLimitSlider, Path=Value, StringFormat={}{0} seconds}"/>

                    </TextBlock>
                </Label>
            </DockPanel>

            <Slider 
                x:Name="TimeLimitSlider"
                Minimum="5"
                Maximum="120"
                Value="{Binding TimeLimitInSeconds}"
                TickPlacement="BottomRight"
                TickFrequency="5"
                IsSnapToTickEnabled="True"
                IsMoveToPointEnabled="True"
                Margin="3 2 3 2"
            />

        </StackPanel>

        <Button
            Grid.Column="0"
            Grid.Row="3"
            Content="Cancel"
            Width="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="10 10 10 15"
            Padding="2"
            IsCancel="True"
            />

        <Button
            Grid.Column="1"
            Grid.Row="3"
            Content="Create"
            Width="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="10 10 10 15"
            Padding="2"
            IsDefault="True"
            />



    </Grid>



</Window>
