<Window x:Class="Labb3_FridaKarlsson_NEU26G.Dialogs.ImportQuestionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb3_FridaKarlsson_NEU26G.Dialogs"
        xmlns:viewmodels="clr-namespace:Labb3_FridaKarlsson_NEU26G.ViewModels"
        mc:Ignorable="d"
        Title="Import Questions from Open Trivia Database" Height="250" Width="300" ResizeMode="NoResize" WindowStyle="ToolWindow"
        d:DataContext="{d:DesignInstance Type=viewmodels:ImportQuestionsViewModel, IsDesignTimeCreatable=True}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
             Grid.Column="0"
             Grid.ColumnSpan="2"
             Grid.Row="0"
             Grid.RowSpan="3"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Center"
             Width="230"
             Margin="10"
     >

            <Label 
                 Content="Category:"
                 FontWeight="Bold"
                 Padding="4 5 4 2"
            />

            <ComboBox 
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                DisplayMemberPath="Name"
                Margin="3 2 3 2"
            />


            <Label 
                 Content="Difficulty"
                 FontWeight="Bold"
                 Padding="4 5 4 2"
            />

            <ComboBox 
                 ItemsSource="{Binding TriviaDifficulties}"
                 SelectedItem="{Binding TriviaDifficulty, UpdateSourceTrigger=PropertyChanged}"
                 Margin="3 2 3 2"
            /> 

            <DockPanel>
                <Label 
                    DockPanel.Dock="Left"
                    FontWeight="Bold"
                    Padding="4 5 4 2"
                >
                    <TextBlock>          
                        <Run Text="Number Of Questions:"/>
                    </TextBlock>
                </Label>

                <Label 
                     DockPanel.Dock="Right"
                     HorizontalAlignment="Right"
                     Padding="4 5 4 2"
                >
                    <TextBlock>                    
                        <Run Text="{Binding NumberOfQuestions, StringFormat={}{0}}"/>
                    </TextBlock>
                </Label>
            </DockPanel>

            <Slider 
                 x:Name="NumberOfQuestionsSlider"
                 Minimum="1"
                 Maximum="20"
                 Value="{Binding NumberOfQuestions, Mode=TwoWay}"
                 TickPlacement="BottomRight"
                 TickFrequency="1"
                 IsSnapToTickEnabled="True"
                 IsMoveToPointEnabled="True"
                 Margin="3 2 3 2"
            />

        </StackPanel>

        <Button
             Grid.Column="0"
             Grid.Row="3"
             Content="Cancel"
             Width="50"
             HorizontalAlignment="Right"
             VerticalAlignment="Center"
             Margin="10 10 15 15"
             Padding="2"
             IsCancel="True"
        />

        <Button
             Grid.Column="1"
             Grid.Row="3"
             Content="Import"
             Width="50"
             HorizontalAlignment="Left"
             VerticalAlignment="Center"
             Margin="15 10 10 15"
             Padding="2"
             IsDefault="True"
             Click="ImportButton_Click"
        />



    </Grid>


</Window>
