<UserControl x:Class="Labb3_FridaKarlsson_NEU26G.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb3_FridaKarlsson_NEU26G.Views"
             xmlns:viewmodels="clr-namespace:Labb3_FridaKarlsson_NEU26G.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:PlayerViewModel, IsDesignTimeCreatable=True}">
    
    
    <Grid>
        
        <Label 
            x:Name="timerLabel"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0 0 10 0"
            FontSize="30"
            FontWeight="Bold"
            Content="{Binding TimeLimitCounter}"
        />

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="480"
        >
        
            <TextBlock                  
                Margin="0 0 0 10"
                FontSize="30"
                TextAlignment="Center"
                TextWrapping="Wrap" 
                Text="{Binding CurrentQuestion.Query}"
            />

            <TextBlock               
                FontSize="14"
                TextAlignment="Center"
            >
                <Run Text="Question no"/>
                <Run Text="{Binding CurrentQuestionNumber}"/>
                <Run Text="out of"/>
                <Run Text="{Binding NumbersOfQuestionsInCurrentPack}"/>
            </TextBlock>

            <Grid 
                Height="180"
                Margin="0 20 0 30"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button
                    Margin="0 0 10 10"
                    FontSize="14"
                    Content="{Binding CurrentAnswers[0]}"
                />

                <Button
                    Grid.Column="1"
                    Margin="10 0 0 10"
                    FontSize="14"
                    Content="{Binding CurrentAnswers[1]}"
                />

                <Button
                    Grid.Row="1"
                    Margin="0 10 10 0"
                    FontSize="14"
                    Content="{Binding CurrentAnswers[2]}"
                />

                <Button
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="10 10 0 0"
                    FontSize="14"
                    Content="{Binding CurrentAnswers[3]}"
                />

            </Grid>

        </StackPanel>
        
    </Grid>
</UserControl>
