<UserControl x:Class="Labb3_FridaKarlsson_NEU26G.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb3_FridaKarlsson_NEU26G.Views"
             mc:Ignorable="d" 
             DataContext="{Binding PlayerViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        
        <Label 
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0 0 10 0"
            FontSize="30"
            FontWeight="Bold"
            Content="00"
        />

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
        >
        
            <TextBox                
                Width="480"
                Margin="0 0 0 10"
                BorderThickness="0"
                FontSize="30"
                TextAlignment="Center"
                TextWrapping="Wrap" 
                Text="Här ställs frågan och det är mycket text ibland om det är en lång "
            />

            <TextBox 
                Width="480"
                BorderThickness="0"
                FontSize="14"
                TextAlignment="Center"
                Text="Question no. out of no."
            />

            <Grid Width="480"
                  Height="180"
                  Margin="0 20 0 30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button
                    Margin="0 0 10 10"
                    FontSize="14"
                    Content="Answer1"
                />

                <Button
                    Grid.Column="1"
                    Margin="10 0 0 10"
                    FontSize="14"
                    Content="Answer2"
                />

                <Button
                    Grid.Row="1"
                    Margin="0 10 10 0"
                    FontSize="14"
                    Content="Answer3"
                />

                <Button
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="10 10 0 0"
                    FontSize="14"
                    Content="Answer4"
                />

            </Grid>

        </StackPanel>
        
    </Grid>
</UserControl>
