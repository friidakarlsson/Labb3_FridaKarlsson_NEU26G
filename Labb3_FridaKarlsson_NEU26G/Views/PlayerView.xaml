<UserControl x:Class="Labb3_FridaKarlsson_NEU26G.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb3_FridaKarlsson_NEU26G.Views"
             xmlns:viewmodels="clr-namespace:Labb3_FridaKarlsson_NEU26G.ViewModels"
             xmlns:fa6="http://schemas.fontawesome.com/icons/svg"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:PlayerViewModel, IsDesignTimeCreatable=True}">
    
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="boolToVisibility"/>
        </Grid.Resources>
        
        <Label 
            x:Name="timerLabel"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0 0 10 0"
            FontSize="30"
            FontWeight="Bold"
            Content="{Binding TimeLimitCounter}"
        />

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="480"
        >
        
            <TextBlock                  
                Margin="0 0 0 10"
                FontSize="30"
                TextAlignment="Center"
                TextWrapping="Wrap" 
                Text="{Binding CurrentQuestion.Query}"
            />

            <TextBlock               
                FontSize="14"
                TextAlignment="Center"
            >
                <Run Text="Question no"/>
                <Run Text="{Binding CurrentQuestionNumber}"/>
                <Run Text="out of"/>
                <Run Text="{Binding NumbersOfQuestionsInCurrentPack}"/>
            </TextBlock>

            <Grid 
                Height="180"
                Margin="0 20 0 30"
            >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button
                    Margin="0 0 10 10"
                    FontSize="14"
                    Content="{Binding CurrentAnswers[0].Text}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding CurrentAnswers[0]}"
                />
                <Image 
                    Source="/Assets/correct.png" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="50"
                    Visibility="{Binding ShowCorrectAnswerIcon[0], Converter={StaticResource boolToVisibility}}"
                />
                <Image 
                    Source="/Assets/incorrect.png" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="50"
                    Visibility="{Binding ShowIncorrectAnswerIcon[0], Converter={StaticResource boolToVisibility}}"
                />

                <Button
                    Grid.Column="1"
                    Margin="10 0 0 10"
                    FontSize="14"
                    Content="{Binding CurrentAnswers[1].Text}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding CurrentAnswers[1]}"
                />
                <Image 
                    Grid.Column="1"
                    Margin="10 0 0 10"
                    Source="/Assets/correct.png" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="50"
                    Visibility="{Binding ShowCorrectAnswerIcon[1], Converter={StaticResource boolToVisibility}}"
                />
                <Image 
                    Grid.Column="1"
                    Margin="10 0 0 10"
                    Source="/Assets/incorrect.png" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="50"
                    Visibility="{Binding ShowIncorrectAnswerIcon[1], Converter={StaticResource boolToVisibility}}"
                />

                <Button
                    Grid.Row="1"
                    Margin="0 10 10 0"
                    FontSize="14"
                    Content="{Binding CurrentAnswers[2].Text}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding CurrentAnswers[2]}"
                />
                <Image 
                    Grid.Row="1"
                    Margin="0 10 10 0"
                    Source="/Assets/correct.png" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="50"
                    Visibility="{Binding ShowCorrectAnswerIcon[2], Converter={StaticResource boolToVisibility}}"
                />
                <Image 
                    Grid.Row="1"
                    Margin="0 10 10 0"
                    Source="/Assets/incorrect.png" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="50"
                    Visibility="{Binding ShowIncorrectAnswerIcon[2], Converter={StaticResource boolToVisibility}}"
                />

                <Button
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="10 10 0 0"
                    FontSize="14"
                    Content="{Binding CurrentAnswers[3].Text}"
                    Command="{Binding SelectAnswerCommand}"
                    CommandParameter="{Binding CurrentAnswers[3]}"
                />
                <Image 
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="10 10 0 0"
                    Source="/Assets/correct.png" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="50"  
                    Visibility="{Binding ShowCorrectAnswerIcon[3], Converter={StaticResource boolToVisibility}}"
                />
                <Image 
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="10 10 0 0"
                    Source="/Assets/incorrect.png"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Width="50"   
                    Visibility="{Binding ShowIncorrectAnswerIcon[3], Converter={StaticResource boolToVisibility}}"
                />

            </Grid>

        </StackPanel>

        <Grid
            Background="White"
            Visibility="{Binding IsQuizOver, Converter={StaticResource boolToVisibility}}"
        >

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                    <Label Content="Complete!" FontSize="40" Margin="10"/>

                    <TextBlock               
                        FontSize="14"
                        TextAlignment="Center"
                        Margin="0 0 0 10"
                    >
                        <Run Text="You got"/>
                        <Run Text="{Binding Score}"/>
                        <Run Text="out of"/>
                        <Run Text="{Binding NumbersOfQuestionsInCurrentPack}"/>
                        <Run Text="answers correct!"/>
                    </TextBlock>

                    <Button
                        Width="100"
                        Height="40"
                        Margin="0 5 0 0"
                        Command="{Binding RestartQuizCommand}"
                    >
                        <StackPanel Orientation="Horizontal">
                            <fa6:SvgAwesome Icon="Solid_ArrowsRotate" Width="14" Height="14" Margin=" 5"/>
                            <TextBlock
                                FontSize="14"
                                VerticalAlignment="Center"
                                Margin="5 10 10 10">
                                <Run Text="Restart!"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                </StackPanel>
        
        </Grid>
        
    </Grid>

    
</UserControl>
