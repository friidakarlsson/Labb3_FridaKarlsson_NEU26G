<UserControl x:Class="Labb3_FridaKarlsson_NEU26G.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb3_FridaKarlsson_NEU26G.Views"
             xmlns:fa6="http://schemas.fontawesome.com/icons/svg"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        
        <Menu>
            
            <MenuItem Header="_File">
                <MenuItem Header="_New Question pack">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_FolderPlus" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Select Question pack">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Regular_FolderOpen" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Delete Question pack">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_FolderMinus" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Margin="2"/>
                <MenuItem Header="_Import Questions" InputGestureText="Ctrl+I">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_CloudArrowDown" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Margin="2"/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_DoorOpen" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            
            
            <MenuItem Header="_Edit">
                <MenuItem Header="_Add Question" InputGestureText="Insert">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_Plus" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Remove Question" InputGestureText="Delete">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_Minus" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pack _Options" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_Sliders" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            
            
            <MenuItem Header="View">
                <MenuItem Header="_Play" InputGestureText="Ctrl+P">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_Play" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Edit" InputGestureText="Ctrl+E">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_Gears" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Margin="2"/>
                <MenuItem Header="_Fullscreen" InputGestureText="Alt+Enter">
                    <MenuItem.Icon>
                        <fa6:SvgAwesome Icon="Solid_Expand" Width="12" Height="12"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            
        </Menu>
        
    </Grid>
</UserControl>
