<UserControl x:Class="Labb3_FridaKarlsson_NEU26G.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb3_FridaKarlsson_NEU26G.Views"
             xmlns:fa6="http://schemas.fontawesome.com/icons/svg"
             mc:Ignorable="d" 
             DataContext="{Binding ConfigurationViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel
            Grid.Column="0"
            Grid.Row="0"
        >            

            <Button 
                DockPanel.Dock="Right" 
                HorizontalAlignment="Right" 
                Height="20"
                Width="20"
                Margin="2 4 5 4"
                Padding="2"
            >
                <fa6:SvgAwesome Icon="Solid_Minus"/>
            </Button>
            
            <Button 
                DockPanel.Dock="Right" 
                HorizontalAlignment="Right" 
                Height="20"
                Width="20"
                Margin="2 4 2 4"
                Padding="2"
            >
                <fa6:SvgAwesome Icon="Solid_Plus"/>
            </Button>

            <Button 
                DockPanel.Dock="Right" 
                HorizontalAlignment="Right" 
                Height="20"
                Width="20"
                Margin="2 4 2 4"
                Padding="2"
            >
                <fa6:SvgAwesome Icon="Solid_Sliders"/>
            </Button>

            <Label  
                Margin="5 4 5 0"
                FontWeight="Bold"
                Content="Question Pack"
            />

        </DockPanel>

        <ListBox
            Grid.Column="0"
            Grid.Row="1"
            Margin="5"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ItemsSource="{Binding ActivePack.Questions}"
            
        >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="Question" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Query}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <Grid
            Grid.Column="1"
            Grid.Row="1"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>            
        
            <Label 
                Grid.Row="0"
                Margin="15 0 20 0"
                FontWeight="Bold"
                Content="Question:"
            />
                
            <TextBox 
                Grid.Row="1"
                Margin="15 0 20 20"                    
                Text="{}"
            />
        

            <StackPanel Grid.Row="2">

                <Label 
                    Margin="15 15 20 0"
                    FontWeight="Bold"
                    Content="Correct answer:"
                />
                <TextBox 
                    Margin="15 0 20 0"                    
                    Text="Correct answer"
                />

                
                <Label 
                    Margin="15 0 20 0"
                    FontWeight="Bold"
                    Content="First Incorrect answer:"
                />
                <TextBox 
                    Margin="15 0 20 0"                    
                    Text="First Incorrect answer"
                />

                
                <Label 
                    Margin="15 0 20 0"
                    FontWeight="Bold"
                    Content="Second Incorrect answer:"
                />
                <TextBox 
                    Margin="15 0 20 0"                    
                    Text="Second Incorrect answer"
                />
                

                <Label 
                    Margin="15 0 20 0"
                    FontWeight="Bold"
                    Content="Third Incorrect answer:"
                />
                <TextBox 
                    Margin="15 0 20 0"                    
                    Text="Third Incorrect answer"
                />
            </StackPanel>    
            
        </Grid>
        
    </Grid>
</UserControl>
